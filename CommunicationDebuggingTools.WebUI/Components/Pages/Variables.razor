@page "/variables"
@implements IDisposable
@using CommunicationDebuggingTools.Core.Enums
@using CommunicationDebuggingTools.Core.Models
@using System.IO
@using System.Text
@inject Services.EngineGateway Gateway
@inject IJSRuntime JS

<PageTitle>变量配置</PageTitle>

<div class="page-titlebar">
    <div>
        <h3>变量配置</h3>
        <div class="page-subtitle">统一管理变量读写、质量与批量导入导出</div>
    </div>
    <div class="status-chip @(Gateway.IsConnected ? "ok" : "error")">
        @(Gateway.IsConnected ? "EngineHost 在线" : "EngineHost 离线")
    </div>
</div>

<div class="card-panel">
    <div class="page-actions">
        <button class="primary" @onclick="OpenAddDialog">新增变量</button>
        <button @onclick="RefreshAsync">刷新</button>
        <button @onclick="ExportCsvAsync">导出CSV</button>
        <label class="button-like" for="var-import-file">导入CSV</label>
        <InputFile id="var-import-file" class="hidden-file-input" OnChange="ImportCsvAsync" accept=".csv,text/csv" />
        @if (!_isSelectMode) {
            <button @onclick="EnterSelectMode">批量删除</button>
        } else {
            <button @onclick="CancelSelectMode">取消多选</button>
            <button class="danger" @onclick="ConfirmBatchDelete">删除选中（@_selectedIds.Count）</button>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_notice)) {
        <div class="@(_noticeIsError ? "banner-error" : "banner-ok")">@_notice</div>
    }

    <div class="panel-title">变量列表</div>
    <div class="table-wrap">
        <table>
            <thead>
            <tr>
                @if (_isSelectMode) {
                    <th style="width:42px;">选</th>
                }
                <th>变量</th>
                <th>设备</th>
                <th>地址</th>
                <th>值</th>
                <th>质量</th>
                <th>错误</th>
                <th>写值</th>
                <th>操作</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var v in Gateway.Variables) {
                <tr>
                    @if (_isSelectMode) {
                        <td>
                            <input type="checkbox"
                                   checked="@_selectedIds.Contains(v.Id)"
                                   @onchange="args => ToggleSelect(v.Id, args)" />
                        </td>
                    }
                    <td>@v.Name</td>
                    <td>@GetDeviceName(v.DeviceId)</td>
                    <td>@v.Address</td>
                    <td>@(v.LastValue?.ToString() ?? "")</td>
                    <td>@v.Quality</td>
                    <td class="error">@v.LastError</td>
                    <td>
                        <input class="inline-input" @bind="_writeBuffer[v.Id]" />
                    </td>
                    <td>
                        <div class="btn-row">
                            <button @onclick="() => ReadAsync(v.Id)">读</button>
                            <button class="success" @onclick="() => WriteAsync(v.Id)">写</button>
                            <button @onclick="() => Edit(v)">编辑</button>
                            <button class="danger" @onclick="() => ConfirmSingleDelete(v.Id)">删除</button>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@if (_showEditDialog) {
    <div class="overlay">
        <div class="dialog-panel dialog-edit">
            <h4>@(_editingId == null ? "新增变量" : "编辑变量")</h4>
            <div class="grid-2" style="margin-bottom:12px;">
                <div class="field">
                    <label>所属设备</label>
                    <select @bind="_editor.DeviceId">
                        @foreach (var d in Gateway.Devices) {
                            <option value="@d.Id">@d.Name</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>变量名称</label>
                    <input @bind="_editor.Name" />
                </div>
                <div class="field">
                    <label>地址</label>
                    <input @bind="_editor.Address" />
                </div>
                <div class="field">
                    <label>数据类型</label>
                    <select @bind="_editor.DataType">
                        @foreach (var dt in Enum.GetValues<VariableDataType>()) {
                            <option value="@dt">@dt</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>访问权限</label>
                    <select @bind="_editor.Access">
                        @foreach (var ac in Enum.GetValues<VariableAccess>()) {
                            <option value="@ac">@ac</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>长度</label>
                    <input type="number" @bind="_editor.Length" />
                </div>
            </div>
            <div class="btn-row">
                <button class="primary" @onclick="SaveAsync">@(_editingId == null ? "新增变量" : "保存修改")</button>
                <button @onclick="CloseEditDialog">取消</button>
            </div>
        </div>
    </div>
}

@if (_showDeleteConfirm) {
    <div class="overlay">
        <div class="dialog-panel">
            <h4>删除确认</h4>
            <p>@_deleteMessage</p>
            <div class="btn-row">
                <button class="danger" @onclick="DeleteConfirmedAsync">确认删除</button>
                <button @onclick="CloseDeleteDialog">取消</button>
            </div>
        </div>
    </div>
}

@code {
    private VariableEditor _editor = new();
    private string _editingId;
    private string _notice;
    private bool _noticeIsError;
    private readonly Dictionary<string, string> _writeBuffer = new();

    private bool _isSelectMode;
    private readonly HashSet<string> _selectedIds = new(StringComparer.OrdinalIgnoreCase);
    private bool _showEditDialog;
    private bool _showDeleteConfirm;
    private bool _deleteIsBatch;
    private string _deleteId;
    private string _deleteMessage = string.Empty;

    protected override void OnInitialized () {
        Gateway.StateChanged += OnGatewayStateChanged;
        PickDefaultDevice();
    }

    public void Dispose () {
        Gateway.StateChanged -= OnGatewayStateChanged;
    }

    private async Task SaveAsync () {
        ClearNotice();
        try {
            if (string.IsNullOrWhiteSpace(_editor.Name) || string.IsNullOrWhiteSpace(_editor.Address)) {
                SetError("变量名称和地址不能为空");
                return;
            }
            if (string.IsNullOrWhiteSpace(_editor.DeviceId)) {
                SetError("请先选择设备");
                return;
            }

            var entity = _editor.ToEntity(_editingId);
            if (string.IsNullOrWhiteSpace(_editingId)) {
                await Gateway.AddVariableAsync(entity);
                SetOk("新增变量成功");
            } else {
                await Gateway.UpdateVariableAsync(entity);
                SetOk("保存变量成功");
            }
            CloseEditDialog();
            await Gateway.RefreshNowAsync();
        } catch (Exception ex) {
            SetError(ex.Message);
        }
    }

    private void OpenAddDialog () {
        _editingId = null;
        _editor = new VariableEditor();
        PickDefaultDevice();
        _showEditDialog = true;
    }

    private void Edit (VariableItem v) {
        _editingId = v.Id;
        _editor = VariableEditor.From(v);
        _showEditDialog = true;
    }

    private void CloseEditDialog () {
        _editingId = null;
        _editor = new VariableEditor();
        PickDefaultDevice();
        _showEditDialog = false;
    }

    private void EnterSelectMode () {
        _isSelectMode = true;
        _selectedIds.Clear();
    }

    private void CancelSelectMode () {
        _isSelectMode = false;
        _selectedIds.Clear();
    }

    private void ToggleSelect (string id, ChangeEventArgs args) {
        bool isChecked = args.Value is bool b && b;
        if (isChecked) {
            _selectedIds.Add(id);
        } else {
            _selectedIds.Remove(id);
        }
    }

    private void ConfirmSingleDelete (string id) {
        _deleteIsBatch = false;
        _deleteId = id;
        _deleteMessage = "确认删除该变量？";
        _showDeleteConfirm = true;
    }

    private void ConfirmBatchDelete () {
        if (_selectedIds.Count == 0) {
            SetError("请先选择要删除的变量");
            return;
        }

        _deleteIsBatch = true;
        _deleteId = null;
        _deleteMessage = $"确认删除选中的 {_selectedIds.Count} 个变量？";
        _showDeleteConfirm = true;
    }

    private async Task DeleteConfirmedAsync () {
        ClearNotice();
        try {
            if (_deleteIsBatch) {
                var ids = _selectedIds.ToList();
                foreach (var id in ids) {
                    await Gateway.RemoveVariableAsync(id);
                }
                _selectedIds.Clear();
                _isSelectMode = false;
                SetOk("批量删除完成");
            } else if (!string.IsNullOrWhiteSpace(_deleteId)) {
                await Gateway.RemoveVariableAsync(_deleteId);
                SetOk("删除变量成功");
            }

            CloseDeleteDialog();
            await Gateway.RefreshNowAsync();
        } catch (Exception ex) {
            SetError(ex.Message);
        }
    }

    private void CloseDeleteDialog () {
        _showDeleteConfirm = false;
        _deleteId = null;
        _deleteMessage = string.Empty;
    }

    private async Task ReadAsync (string id) {
        ClearNotice();
        try {
            var result = await Gateway.ReadVariableAsync(id);
            SetNotice(result.Success ? "读取成功" : result.ErrorMessage, !result.Success);
            await Gateway.RefreshNowAsync();
        } catch (Exception ex) {
            SetError(ex.Message);
        }
    }

    private async Task WriteAsync (string id) {
        ClearNotice();
        try {
            _writeBuffer.TryGetValue(id, out var val);
            var result = await Gateway.WriteVariableAsync(id, val ?? "");
            SetNotice(result.Success ? "写入成功" : result.ErrorMessage, !result.Success);
            await Gateway.RefreshNowAsync();
        } catch (Exception ex) {
            SetError(ex.Message);
        }
    }

    private async Task RefreshAsync () {
        ClearNotice();
        try {
            await Gateway.RefreshNowAsync();
            SetOk("刷新完成");
        } catch (Exception ex) {
            SetError(ex.Message);
        }
    }

    private async Task ExportCsvAsync () {
        ClearNotice();
        try {
            var sb = new StringBuilder();
            sb.AppendLine("Id,DeviceId,Name,Address,DataType,Access,Length,Unit,Category,Description,ScanRateMs,IsPollingEnabled");
            foreach (var v in Gateway.Variables) {
                sb.AppendLine(string.Join(",", new[] {
                    CsvEscape(v.Id),
                    CsvEscape(v.DeviceId),
                    CsvEscape(v.Name),
                    CsvEscape(v.Address),
                    CsvEscape(v.DataType.ToString()),
                    CsvEscape(v.Access.ToString()),
                    CsvEscape(v.Length.ToString()),
                    CsvEscape(v.Unit),
                    CsvEscape(v.Category),
                    CsvEscape(v.Description),
                    CsvEscape(v.ScanRateMs.ToString()),
                    CsvEscape(v.IsPollingEnabled.ToString())
                }));
            }

            string fileName = $"variables-{DateTime.Now:yyyyMMdd-HHmmss}.csv";
            await JS.InvokeVoidAsync("cdtDownload.downloadTextFile", fileName, sb.ToString(), "text/csv;charset=utf-8;");
            SetOk("导出成功");
        } catch (Exception ex) {
            SetError(ex.Message);
        }
    }

    private async Task ImportCsvAsync (InputFileChangeEventArgs e) {
        ClearNotice();
        try {
            var file = e.File;
            if (file == null) {
                SetError("未选择文件");
                return;
            }

            await using var stream = file.OpenReadStream(5 * 1024 * 1024);
            using var reader = new StreamReader(stream, Encoding.UTF8, true);
            string content = await reader.ReadToEndAsync();
            var lines = content.Replace("\r\n", "\n").Replace('\r', '\n').Split('\n', StringSplitOptions.RemoveEmptyEntries);
            if (lines.Length <= 1) {
                SetError("CSV 内容为空");
                return;
            }

            var header = ParseCsvLine(lines[0]);
            var index = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
            for (int i = 0; i < header.Count; i++) {
                index[header[i]] = i;
            }

            int imported = 0;
            int failed = 0;
            for (int i = 1; i < lines.Length; i++) {
                var cols = ParseCsvLine(lines[i]);
                if (cols.Count == 0) continue;

                try {
                    string id = GetCol(cols, index, "Id");
                    string deviceId = GetCol(cols, index, "DeviceId");
                    string name = GetCol(cols, index, "Name");
                    string address = GetCol(cols, index, "Address");
                    if (string.IsNullOrWhiteSpace(deviceId) || string.IsNullOrWhiteSpace(name) || string.IsNullOrWhiteSpace(address)) {
                        failed++;
                        continue;
                    }

                    var item = new VariableItem {
                        Id = string.IsNullOrWhiteSpace(id) ? Guid.NewGuid().ToString("N") : id,
                        DeviceId = deviceId,
                        Name = name,
                        Address = address,
                        DataType = ParseEnum(GetCol(cols, index, "DataType"), VariableDataType.Int16),
                        Access = ParseEnum(GetCol(cols, index, "Access"), VariableAccess.ReadWrite),
                        Length = ParseInt(GetCol(cols, index, "Length"), 0),
                        Unit = GetCol(cols, index, "Unit"),
                        Category = GetCol(cols, index, "Category"),
                        Description = GetCol(cols, index, "Description"),
                        ScanRateMs = ParseInt(GetCol(cols, index, "ScanRateMs"), 1000),
                        IsPollingEnabled = ParseBool(GetCol(cols, index, "IsPollingEnabled"), true)
                    };

                    bool exists = Gateway.Variables.Any(x => x.Id == item.Id);
                    if (exists) {
                        await Gateway.UpdateVariableAsync(item);
                    } else {
                        await Gateway.AddVariableAsync(item);
                    }
                    imported++;
                } catch {
                    failed++;
                }
            }

            await Gateway.RefreshNowAsync();
            SetNotice($"导入完成：成功 {imported} 条，失败 {failed} 条", failed > 0);
        } catch (Exception ex) {
            SetError(ex.Message);
        }
    }

    private static string CsvEscape (string value) {
        string v = value ?? string.Empty;
        if (v.Contains('"')) v = v.Replace("\"", "\"\"");
        if (v.Contains(',') || v.Contains('\n') || v.Contains('\r') || v.Contains('"')) {
            return $"\"{v}\"";
        }
        return v;
    }

    private static List<string> ParseCsvLine (string line) {
        var result = new List<string>();
        if (line == null) return result;

        var sb = new StringBuilder();
        bool inQuotes = false;
        for (int i = 0; i < line.Length; i++) {
            char c = line[i];
            if (c == '"') {
                if (inQuotes && i + 1 < line.Length && line[i + 1] == '"') {
                    sb.Append('"');
                    i++;
                } else {
                    inQuotes = !inQuotes;
                }
            } else if (c == ',' && !inQuotes) {
                result.Add(sb.ToString());
                sb.Clear();
            } else {
                sb.Append(c);
            }
        }
        result.Add(sb.ToString());
        return result;
    }

    private static string GetCol (IReadOnlyList<string> cols, IReadOnlyDictionary<string, int> index, string key) {
        if (!index.TryGetValue(key, out int idx)) return string.Empty;
        if (idx < 0 || idx >= cols.Count) return string.Empty;
        return cols[idx]?.Trim() ?? string.Empty;
    }

    private static int ParseInt (string value, int fallback) {
        return int.TryParse(value, out var n) ? n : fallback;
    }

    private static bool ParseBool (string value, bool fallback) {
        return bool.TryParse(value, out var b) ? b : fallback;
    }

    private static T ParseEnum<T> (string value, T fallback) where T : struct {
        return Enum.TryParse<T>(value, true, out var parsed) ? parsed : fallback;
    }

    private void OnGatewayStateChanged () {
        _ = InvokeAsync(() => {
            foreach (var item in Gateway.Variables) {
                _writeBuffer.TryAdd(item.Id, item.LastValue?.ToString() ?? string.Empty);
            }
            PickDefaultDevice();
            StateHasChanged();
        });
    }

    private string GetDeviceName (string deviceId) {
        return Gateway.Devices.FirstOrDefault(d => d.Id == deviceId)?.Name ?? deviceId;
    }

    private void PickDefaultDevice () {
        if (!string.IsNullOrWhiteSpace(_editor.DeviceId)) return;
        _editor.DeviceId = Gateway.Devices.FirstOrDefault()?.Id ?? string.Empty;
    }

    private void SetOk (string msg) => SetNotice(msg, false);
    private void SetError (string msg) => SetNotice(msg, true);
    private void SetNotice (string msg, bool isError) {
        _notice = msg;
        _noticeIsError = isError;
    }
    private void ClearNotice () {
        _notice = null;
        _noticeIsError = false;
    }

    private sealed class VariableEditor {
        public string DeviceId { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Address { get; set; } = string.Empty;
        public VariableDataType DataType { get; set; } = VariableDataType.Int16;
        public VariableAccess Access { get; set; } = VariableAccess.ReadWrite;
        public int Length { get; set; }

        public VariableItem ToEntity (string id) {
            return new VariableItem {
                Id = id ?? Guid.NewGuid().ToString("N"),
                DeviceId = DeviceId,
                Name = Name?.Trim() ?? string.Empty,
                Address = Address?.Trim() ?? string.Empty,
                DataType = DataType,
                Access = Access,
                Length = Length
            };
        }

        public static VariableEditor From (VariableItem v) {
            return new VariableEditor {
                DeviceId = v.DeviceId,
                Name = v.Name,
                Address = v.Address,
                DataType = v.DataType,
                Access = v.Access,
                Length = v.Length
            };
        }
    }
}
