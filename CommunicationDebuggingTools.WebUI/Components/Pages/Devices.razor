@page "/"
@page "/devices"
@implements IDisposable
@inject Services.EngineGateway Gateway

<PageTitle>设备管理</PageTitle>

<div class="page-titlebar">
    <div>
        <h3>设备管理</h3>
        <div class="page-subtitle">管理设备连接、参数与在线状态</div>
    </div>
    <div class="status-chip @(Gateway.IsConnected ? "ok" : "error")">
        @(Gateway.IsConnected ? "EngineHost 在线" : "EngineHost 离线")
    </div>
</div>

<div class="card-panel">
    <div class="page-actions device-toolbar">
        <button class="primary" @onclick="OpenAddDialog">新增设备</button>
        <button class="success" @onclick="ConnectAllAsync">全部连接</button>
        <button class="danger" @onclick="DisconnectAllAsync">全部断开</button>
        <button @onclick="RefreshAsync">刷新</button>
        @if (!_isSelectMode) {
            <button @onclick="EnterSelectMode">批量删除</button>
        } else {
            <button @onclick="CancelSelectMode">取消多选</button>
            <button class="danger" @onclick="ConfirmBatchDelete">删除选中（@_selectedIds.Count）</button>
        }
        <div class="panel-meta">
            <span class="meta-pill">总数 @Gateway.Devices.Count</span>
            <span class="meta-pill ok">在线 @OnlineDeviceCount</span>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_notice)) {
        <div class="@(_noticeIsError ? "banner-error" : "banner-ok")">@_notice</div>
    }

    <div class="panel-title">设备列表</div>
    <div class="dev-grid">
        @foreach (var d in Gateway.Devices) {
            <div class="plc-card @(_selectedIds.Contains(d.Id) ? "selected" : "")">
                <div class="plc-hd">
                    <div class="left">
                        <div class="bar"></div>
                        <div>
                            <div class="name">@d.Name</div>
                            <div class="model">@(string.IsNullOrWhiteSpace(d.Model) ? "未配置型号" : d.Model)</div>
                        </div>
                    </div>
                    <div class="right">
                        @if (_isSelectMode) {
                            <label class="card-select">
                                <input type="checkbox"
                                       checked="@_selectedIds.Contains(d.Id)"
                                       @onchange="args => ToggleSelect(d.Id, args)" />
                                选择
                            </label>
                        }
                        <div class="led @(d.IsConnected ? "on" : "off")"></div>
                    </div>
                </div>
                <div class="plc-body">
                    <div class="plc-info">
                        <div class="info-row"><span class="label">IP 地址</span><span class="value mono">@d.Ip:@d.Port</span></div>
                        <div class="info-row"><span class="label">协议</span><span class="value">@d.Protocol</span></div>
                        <div class="info-row"><span class="label">当前状态</span><span class="value @(d.IsConnected ? "run" : "offline")">@(d.IsConnected ? "已连接" : "未连接")</span></div>
                    </div>
                    <div class="plc-btns">
                        @if (d.IsConnected) {
                            <button class="plc-btn disconnect" @onclick="() => DisconnectAsync(d.Id)">断开</button>
                        } else {
                            <button class="plc-btn connect" @onclick="() => ConnectAsync(d.Id)">连接</button>
                        }
                        <button class="plc-btn edit" @onclick="() => Edit(d)">编辑</button>
                        <button class="plc-btn delete" @onclick="() => ConfirmSingleDelete(d.Id)">删除</button>
                    </div>
                </div>
            </div>
        }

        @if (!_isSelectMode) {
            <div class="plc-add-card" @onclick="OpenAddDialog">
                <div class="plus">+</div>
                <div class="text">添加新设备</div>
            </div>
        }
    </div>
</div>

@if (_showEditDialog) {
    <div class="overlay">
        <div class="dialog-panel dialog-edit">
            <h4>@(_editingId == null ? "新增设备" : "编辑设备")</h4>
            <div class="grid-2" style="margin-bottom:12px;">
                <div class="field">
                    <label>名称</label>
                    <input @bind="_editor.Name" />
                </div>
                <div class="field">
                    <label>协议</label>
                    <select @bind="_editor.Protocol">
                        @foreach (var protocol in ProtocolOptions) {
                            <option value="@protocol">@protocol</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>型号</label>
                    <input @bind="_editor.Model" />
                </div>
                <div class="field">
                    <label>IP</label>
                    <input @bind="_editor.Ip" />
                </div>
                <div class="field">
                    <label>端口</label>
                    <input type="number" @bind="_editor.Port" />
                </div>
                <div class="field">
                    <label>站号</label>
                    <input type="number" @bind="_editor.StationNo" />
                </div>
            </div>
            <div class="btn-row">
                <button class="primary" @onclick="SaveAsync">@(_editingId == null ? "新增设备" : "保存修改")</button>
                <button @onclick="CloseEditDialog">取消</button>
            </div>
        </div>
    </div>
}

@if (_showDeleteConfirm) {
    <div class="overlay">
        <div class="dialog-panel">
            <h4>删除确认</h4>
            <p>@_deleteMessage</p>
            <div class="btn-row">
                <button class="danger" @onclick="DeleteConfirmedAsync">确认删除</button>
                <button @onclick="CloseDeleteDialog">取消</button>
            </div>
        </div>
    </div>
}

@code {
    private static readonly string[] DefaultProtocolOptions = [
        "Modbus TCP",
        "Siemens S7",
        "Panasonic Mewtocol"
    ];

    private IReadOnlyList<string> ProtocolOptions => Gateway.ProtocolNames.Count > 0 ? Gateway.ProtocolNames : DefaultProtocolOptions;

    private DeviceEditor _editor = new();
    private string _editingId;
    private string _notice;
    private bool _noticeIsError;

    private bool _isSelectMode;
    private readonly HashSet<string> _selectedIds = new(StringComparer.OrdinalIgnoreCase);
    private bool _showEditDialog;
    private bool _showDeleteConfirm;
    private bool _deleteIsBatch;
    private string _deleteId;
    private string _deleteMessage = string.Empty;

    private int OnlineDeviceCount => Gateway.Devices.Count(d => d.IsConnected);

    protected override async Task OnInitializedAsync () {
        Gateway.StateChanged += OnGatewayStateChanged;
        await Gateway.RefreshNowAsync();
    }

    public void Dispose () {
        Gateway.StateChanged -= OnGatewayStateChanged;
    }

    private async Task SaveAsync () {
        ClearNotice();
        try {
            if (string.IsNullOrWhiteSpace(_editor.Name) || string.IsNullOrWhiteSpace(_editor.Protocol)) {
                SetError("名称和协议不能为空");
                return;
            }

            var entity = _editor.ToEntity(_editingId);
            if (string.IsNullOrWhiteSpace(_editingId)) {
                await Gateway.AddDeviceAsync(entity);
                SetOk("新增设备成功");
            } else {
                await Gateway.UpdateDeviceAsync(entity);
                SetOk("保存设备成功");
            }
            CloseEditDialog();
            await Gateway.RefreshNowAsync();
        } catch (Exception ex) {
            SetError(ex.Message);
        }
    }

    private void OpenAddDialog () {
        _editingId = null;
        _editor = new DeviceEditor();
        _showEditDialog = true;
    }

    private void Edit (CommunicationDebuggingTools.Core.Models.DeviceInfo d) {
        _editingId = d.Id;
        _editor = DeviceEditor.From(d);
        _showEditDialog = true;
    }

    private void CloseEditDialog () {
        _editingId = null;
        _editor = new DeviceEditor();
        _showEditDialog = false;
    }

    private void EnterSelectMode () {
        _isSelectMode = true;
        _selectedIds.Clear();
    }

    private void CancelSelectMode () {
        _isSelectMode = false;
        _selectedIds.Clear();
    }

    private void ToggleSelect (string id, ChangeEventArgs args) {
        bool isChecked = args.Value is bool b && b;
        if (isChecked) {
            _selectedIds.Add(id);
        } else {
            _selectedIds.Remove(id);
        }
    }

    private void ConfirmSingleDelete (string id) {
        _deleteIsBatch = false;
        _deleteId = id;
        _deleteMessage = "确认删除该设备？";
        _showDeleteConfirm = true;
    }

    private void ConfirmBatchDelete () {
        if (_selectedIds.Count == 0) {
            SetError("请先选择要删除的设备");
            return;
        }
        _deleteIsBatch = true;
        _deleteId = null;
        _deleteMessage = $"确认删除选中的 {_selectedIds.Count} 台设备？";
        _showDeleteConfirm = true;
    }

    private async Task DeleteConfirmedAsync () {
        ClearNotice();
        try {
            if (_deleteIsBatch) {
                var ids = _selectedIds.ToList();
                foreach (var id in ids) {
                    await Gateway.RemoveDeviceAsync(id);
                }
                _selectedIds.Clear();
                _isSelectMode = false;
                SetOk("批量删除完成");
            } else if (!string.IsNullOrWhiteSpace(_deleteId)) {
                await Gateway.RemoveDeviceAsync(_deleteId);
                SetOk("删除设备成功");
            }

            CloseDeleteDialog();
            await Gateway.RefreshNowAsync();
        } catch (Exception ex) {
            SetError(ex.Message);
        }
    }

    private void CloseDeleteDialog () {
        _showDeleteConfirm = false;
        _deleteId = null;
        _deleteMessage = string.Empty;
    }

    private async Task ConnectAsync (string id) {
        ClearNotice();
        try {
            bool ok = await Gateway.ConnectDeviceAsync(id);
            SetNotice(ok ? "设备连接成功" : "设备连接失败", !ok);
            await Gateway.RefreshNowAsync();
        } catch (Exception ex) {
            SetError(ex.Message);
        }
    }

    private async Task DisconnectAsync (string id) {
        ClearNotice();
        try {
            await Gateway.DisconnectDeviceAsync(id);
            SetOk("设备已断开");
            await Gateway.RefreshNowAsync();
        } catch (Exception ex) {
            SetError(ex.Message);
        }
    }

    private async Task ConnectAllAsync () {
        ClearNotice();
        try {
            await Gateway.ConnectAllAsync();
            SetOk("已执行全部连接");
            await Gateway.RefreshNowAsync();
        } catch (Exception ex) {
            SetError(ex.Message);
        }
    }

    private async Task DisconnectAllAsync () {
        ClearNotice();
        try {
            await Gateway.DisconnectAllAsync();
            SetOk("已执行全部断开");
            await Gateway.RefreshNowAsync();
        } catch (Exception ex) {
            SetError(ex.Message);
        }
    }

    private async Task RefreshAsync () {
        ClearNotice();
        try {
            await Gateway.RefreshNowAsync();
            SetOk("刷新完成");
        } catch (Exception ex) {
            SetError(ex.Message);
        }
    }

    private void OnGatewayStateChanged () {
        _ = InvokeAsync(StateHasChanged);
    }

    private void SetOk (string msg) => SetNotice(msg, false);
    private void SetError (string msg) => SetNotice(msg, true);
    private void SetNotice (string msg, bool isError) {
        _notice = msg;
        _noticeIsError = isError;
    }
    private void ClearNotice () {
        _notice = null;
        _noticeIsError = false;
    }

    private sealed class DeviceEditor {
        public string Name { get; set; } = "";
        public string Protocol { get; set; } = "Modbus TCP";
        public string Model { get; set; } = "";
        public string Ip { get; set; } = "127.0.0.1";
        public int Port { get; set; } = 502;
        public int StationNo { get; set; } = 1;

        public CommunicationDebuggingTools.Core.Models.DeviceInfo ToEntity (string id) {
            return new CommunicationDebuggingTools.Core.Models.DeviceInfo {
                Id = id ?? Guid.NewGuid().ToString("N"),
                Name = Name?.Trim() ?? string.Empty,
                Protocol = Protocol?.Trim() ?? string.Empty,
                Model = Model?.Trim() ?? string.Empty,
                Ip = Ip?.Trim() ?? string.Empty,
                Port = Port,
                StationNo = StationNo,
                ExtraSettingsJson = "{}"
            };
        }

        public static DeviceEditor From (CommunicationDebuggingTools.Core.Models.DeviceInfo d) {
            return new DeviceEditor {
                Name = d.Name,
                Protocol = d.Protocol,
                Model = d.Model,
                Ip = d.Ip,
                Port = d.Port,
                StationNo = d.StationNo
            };
        }
    }
}
