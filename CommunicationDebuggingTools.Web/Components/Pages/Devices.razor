@page "/devices"
@inject EngineHostApiClient Api

<PageTitle>设备管理</PageTitle>

<h1>设备管理</h1>

<div class="mb-3 d-flex gap-2">
    <button class="btn btn-primary" @onclick="RefreshAsync" disabled="@_busy">刷新</button>
    <button class="btn btn-success" @onclick="NewDevice">新增设备</button>
</div>

@if (!string.IsNullOrWhiteSpace(_message)) {
    <div class="alert @(_error ? "alert-danger" : "alert-info")">@_message</div>
}

<div class="card mb-3">
    <div class="card-header">@(_editingId is null ? "新增设备" : "编辑设备")</div>
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-3">
                <label class="form-label">名称</label>
                <input class="form-control" @bind="_form.Name" />
            </div>
            <div class="col-md-3">
                <label class="form-label">型号</label>
                <input class="form-control" @bind="_form.Model" />
            </div>
            <div class="col-md-3">
                <label class="form-label">协议</label>
                <select class="form-select" @bind="_form.Protocol">
                    @foreach (var p in _protocols) {
                        <option value="@p">@p</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">产线轨道</label>
                <select class="form-select" @bind="_form.Lane">
                    <option value="Single">Single</option>
                    <option value="Dual">Dual</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">IP</label>
                <input class="form-control" @bind="_form.Ip" />
            </div>
            <div class="col-md-2">
                <label class="form-label">端口</label>
                <input class="form-control" type="number" @bind="_form.Port" />
            </div>
            <div class="col-md-2">
                <label class="form-label">站号</label>
                <input class="form-control" type="number" @bind="_form.StationNo" />
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_busy">保存</button>
            <button class="btn btn-outline-secondary" @onclick="CancelEdit">取消</button>
        </div>
    </div>
</div>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>名称</th>
            <th>协议</th>
            <th>地址</th>
            <th>状态</th>
            <th style="width:320px">操作</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in _devices) {
            <tr>
                <td>@d.Name</td>
                <td>@d.Protocol</td>
                <td>@d.Ip:@d.Port</td>
                <td>@(d.IsConnected ? "已连接" : "未连接")</td>
                <td class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => EditDevice(d)">编辑</button>
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(d)">删除</button>
                    <button class="btn btn-sm btn-outline-success" @onclick="() => ConnectAsync(d)">连接</button>
                    <button class="btn btn-sm btn-outline-warning" @onclick="() => DisconnectAsync(d)">断开</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private readonly List<DeviceDto> _devices = new();
    private readonly List<string> _protocols = new();
    private DeviceUpsertRequest _form = new() { Port = 502, StationNo = 1, Lane = "Single" };
    private string? _editingId;
    private bool _busy;
    private string? _message;
    private bool _error;

    protected override async Task OnInitializedAsync () {
        await RefreshAsync();
    }

    private async Task RefreshAsync () {
        await ExecuteAsync(async () => {
            _devices.Clear();
            _devices.AddRange(await Api.GetDevicesAsync());

            _protocols.Clear();
            _protocols.AddRange(await Api.GetProtocolsAsync());
            if (_protocols.Count == 0) {
                _protocols.Add("Modbus TCP");
            }

            if (string.IsNullOrWhiteSpace(_form.Protocol)) {
                _form.Protocol = _protocols[0];
            }
        }, "刷新成功");
    }

    private void NewDevice () {
        _editingId = null;
        _form = new DeviceUpsertRequest { Port = 502, StationNo = 1, Lane = "Single", Protocol = _protocols.FirstOrDefault() ?? "Modbus TCP" };
    }

    private void EditDevice (DeviceDto d) {
        _editingId = d.Id;
        _form = new DeviceUpsertRequest {
            Name = d.Name,
            Model = d.Model,
            Protocol = d.Protocol,
            Ip = d.Ip,
            Port = d.Port,
            StationNo = d.StationNo,
            Lane = d.Lane
        };
    }

    private async Task SaveAsync () {
        if (string.IsNullOrWhiteSpace(_form.Name) || string.IsNullOrWhiteSpace(_form.Protocol)) {
            SetMessage("名称和协议不能为空", true);
            return;
        }

        await ExecuteAsync(async () => {
            if (string.IsNullOrWhiteSpace(_editingId)) {
                await Api.CreateDeviceAsync(_form);
            } else {
                await Api.UpdateDeviceAsync(_editingId, _form);
            }
            await RefreshAsync();
            NewDevice();
        }, "保存成功");
    }

    private async Task DeleteAsync (DeviceDto d) {
        await ExecuteAsync(async () => {
            await Api.DeleteDeviceAsync(d.Id);
            await RefreshAsync();
        }, "删除成功");
    }

    private async Task ConnectAsync (DeviceDto d) {
        await ExecuteAsync(async () => {
            bool ok = await Api.ConnectDeviceAsync(d.Id);
            await RefreshAsync();
            SetMessage(ok ? "连接成功" : "连接失败", !ok);
        }, null);
    }

    private async Task DisconnectAsync (DeviceDto d) {
        await ExecuteAsync(async () => {
            await Api.DisconnectDeviceAsync(d.Id);
            await RefreshAsync();
        }, "已断开");
    }

    private void CancelEdit () => NewDevice();

    private async Task ExecuteAsync (Func<Task> action, string? successMessage) {
        _busy = true;
        try {
            await action();
            if (!string.IsNullOrWhiteSpace(successMessage)) {
                SetMessage(successMessage, false);
            }
        } catch (Exception ex) {
            SetMessage(ex.Message, true);
        } finally {
            _busy = false;
        }
    }

    private void SetMessage (string? message, bool isError) {
        _message = message;
        _error = isError;
    }
}
