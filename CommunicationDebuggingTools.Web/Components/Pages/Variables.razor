@page "/variables"
@inject EngineHostApiClient Api

<PageTitle>变量配置</PageTitle>

<h1>变量配置</h1>

<div class="mb-3 d-flex gap-2">
    <button class="btn btn-primary" @onclick="RefreshAsync" disabled="@_busy">刷新</button>
    <button class="btn btn-success" @onclick="NewVariable">新增变量</button>
</div>

@if (!string.IsNullOrWhiteSpace(_message)) {
    <div class="alert @(_error ? "alert-danger" : "alert-info")">@_message</div>
}

<div class="card mb-3">
    <div class="card-header">@(_editingId is null ? "新增变量" : "编辑变量")</div>
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-3">
                <label class="form-label">所属设备</label>
                <select class="form-select" @bind="_form.DeviceId">
                    <option value="">请选择设备</option>
                    @foreach (var d in _devices) {
                        <option value="@d.Id">@d.Name (@d.Protocol)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">变量名称</label>
                <input class="form-control" @bind="_form.Name" />
            </div>
            <div class="col-md-3">
                <label class="form-label">地址</label>
                <input class="form-control" @bind="_form.Address" />
            </div>
            <div class="col-md-3">
                <label class="form-label">数据类型</label>
                <select class="form-select" @bind="_form.DataType">
                    @foreach (var t in _dataTypes) {
                        <option value="@t">@t</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">访问权限</label>
                <select class="form-select" @bind="_form.Access">
                    <option value="Read">Read</option>
                    <option value="Write">Write</option>
                    <option value="ReadWrite">ReadWrite</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">长度</label>
                <input class="form-control" type="number" @bind="_form.Length" />
            </div>
            <div class="col-md-2">
                <label class="form-label">单位</label>
                <input class="form-control" @bind="_form.Unit" />
            </div>
            <div class="col-md-2">
                <label class="form-label">类别</label>
                <input class="form-control" @bind="_form.Category" />
            </div>
            <div class="col-md-3">
                <label class="form-label">描述</label>
                <input class="form-control" @bind="_form.Description" />
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_busy">保存</button>
            <button class="btn btn-outline-secondary" @onclick="CancelEdit">取消</button>
        </div>
    </div>
</div>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>变量</th>
            <th>设备</th>
            <th>地址</th>
            <th>类型</th>
            <th>值</th>
            <th>质量</th>
            <th style="width:340px">操作</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var v in _variables) {
            <tr>
                <td>@v.Name</td>
                <td>@GetDeviceName(v.DeviceId)</td>
                <td>@v.Address</td>
                <td>@v.DataType</td>
                <td>@v.Value</td>
                <td>@v.Quality</td>
                <td class="d-flex gap-2 align-items-center">
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => EditVariable(v)">编辑</button>
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(v)">删除</button>
                    <button class="btn btn-sm btn-outline-success" @onclick="() => ReadAsync(v)">读</button>
                    <input class="form-control form-control-sm" style="width:90px" @bind="_writeValues[v.Id]" placeholder="写值" />
                    <button class="btn btn-sm btn-outline-warning" @onclick="() => WriteAsync(v)">写</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private readonly List<DeviceDto> _devices = new();
    private readonly List<VariableDto> _variables = new();
    private readonly Dictionary<string, string> _writeValues = new();
    private readonly string[] _dataTypes = ["Bool", "Int16", "UInt16", "Int32", "UInt32", "Float", "Double", "String"];

    private VariableUpsertRequest _form = new();
    private string? _editingId;
    private bool _busy;
    private string? _message;
    private bool _error;

    protected override async Task OnInitializedAsync () {
        await RefreshAsync();
    }

    private async Task RefreshAsync () {
        await ExecuteAsync(async () => {
            _devices.Clear();
            _devices.AddRange(await Api.GetDevicesAsync());

            _variables.Clear();
            _variables.AddRange(await Api.GetVariablesAsync());
            _writeValues.Clear();
            foreach (var v in _variables) {
                _writeValues[v.Id] = string.Empty;
            }
        }, "刷新成功");
    }

    private void NewVariable () {
        _editingId = null;
        _form = new VariableUpsertRequest {
            DataType = "Int16",
            Access = "ReadWrite",
            Category = "状态点",
            DeviceId = _devices.FirstOrDefault()?.Id ?? string.Empty
        };
    }

    private void EditVariable (VariableDto v) {
        _editingId = v.Id;
        _form = new VariableUpsertRequest {
            DeviceId = v.DeviceId,
            Name = v.Name,
            Address = v.Address,
            DataType = v.DataType,
            Access = v.Access,
            Length = v.Length,
            Unit = v.Unit,
            Category = v.Category,
            Description = v.Description
        };
    }

    private async Task SaveAsync () {
        if (string.IsNullOrWhiteSpace(_form.DeviceId) || string.IsNullOrWhiteSpace(_form.Name) || string.IsNullOrWhiteSpace(_form.Address)) {
            SetMessage("设备、名称、地址不能为空", true);
            return;
        }

        await ExecuteAsync(async () => {
            if (string.IsNullOrWhiteSpace(_editingId)) {
                await Api.CreateVariableAsync(_form);
            } else {
                await Api.UpdateVariableAsync(_editingId, _form);
            }

            await RefreshAsync();
            NewVariable();
        }, "保存成功");
    }

    private async Task DeleteAsync (VariableDto v) {
        await ExecuteAsync(async () => {
            await Api.DeleteVariableAsync(v.Id);
            await RefreshAsync();
        }, "删除成功");
    }

    private async Task ReadAsync (VariableDto v) {
        await ExecuteAsync(async () => {
            var result = await Api.ReadVariableAsync(v.Id);
            await RefreshAsync();
            SetMessage(result?.Success == true ? $"读取成功: {result.Value}" : $"读取失败: {result?.Message}", result?.Success != true);
        }, null);
    }

    private async Task WriteAsync (VariableDto v) {
        _writeValues.TryGetValue(v.Id, out var writeValue);
        await ExecuteAsync(async () => {
            var result = await Api.WriteVariableAsync(v.Id, writeValue ?? string.Empty);
            await RefreshAsync();
            SetMessage(result?.Success == true ? "写入成功" : $"写入失败: {result?.Message}", result?.Success != true);
        }, null);
    }

    private void CancelEdit () => NewVariable();

    private string GetDeviceName (string deviceId) {
        var d = _devices.FirstOrDefault(x => x.Id == deviceId);
        return d?.Name ?? deviceId;
    }

    private async Task ExecuteAsync (Func<Task> action, string? successMessage) {
        _busy = true;
        try {
            await action();
            if (!string.IsNullOrWhiteSpace(successMessage)) {
                SetMessage(successMessage, false);
            }
        } catch (Exception ex) {
            SetMessage(ex.Message, true);
        } finally {
            _busy = false;
        }
    }

    private void SetMessage (string? message, bool isError) {
        _message = message;
        _error = isError;
    }
}
