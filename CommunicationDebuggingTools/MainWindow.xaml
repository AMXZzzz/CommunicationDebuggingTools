<Window x:Class="CommunicationDebuggingTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:device="clr-namespace:CommunicationDebuggingTools.Views.Pages.Device"
        xmlns:monitor="clr-namespace:CommunicationDebuggingTools.Views.Pages.Monitor"
        xmlns:log="clr-namespace:CommunicationDebuggingTools.Views.Pages.Log"
        xmlns:settings="clr-namespace:CommunicationDebuggingTools.Views.Pages.Settings"
        Title="MainWindow"
        WindowStyle="None"
        Height="{StaticResource SF.ControlsSize.MainWindowsHeight}"
        Width="{StaticResource SF.ControlsSize.MainWindowsWidth}"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Background="{StaticResource SF.Brush.Bg.App}">

    <!-- ==================== 自定义窗口铬（无系统标题栏） ==================== -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 顶栏 -->
            <RowDefinition Height="Auto"/>
            <!-- 主体（侧栏 + 内容） -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== 顶栏 ==================== -->
        <Border Grid.Row="0"
                Background="{StaticResource SF.Brush.Bg.TopBar}"
                BorderBrush="{StaticResource SF.Brush.Border.Default}"
                BorderThickness="0 0 0 1"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">

            <Grid Margin="16 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：标题 + 版本 -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Communication Debugging Tools"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SF.Brush.Text.Primary}"/>
                    <TextBlock Text="V0.1"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SF.Brush.Text.Secondary}"
                               VerticalAlignment="Center"
                               Margin="4 0 0 0"/>
                </StackPanel>

                <!-- 中间：当前设备 -->
                <TextBlock x:Name="txtCurrentDevice"
                           Grid.Column="1"
                           Text="未连接设备"
                           FontSize="13"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <!-- 右侧：状态 + 功能按钮 -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- 连接状态灯 -->
                    <Ellipse x:Name="statusIndicator"
                             Width="10" Height="10"
                             Fill="{StaticResource SF.Brush.Text.Secondary}"
                             Margin="0 0 8 0"/>
                    <TextBlock x:Name="txtStatus"
                               Text="未连接"
                               Foreground="{StaticResource SF.Brush.Text.Secondary}"
                               VerticalAlignment="Center"
                               Margin="0 0 16 0"/>

                    <!-- 语言切换 -->
                    <Button Content="中 / EN"
                            Click="BtnLanguage_Click"
                            Background="Transparent"
                            Foreground="{StaticResource SF.Brush.Text.Secondary}"
                            BorderThickness="0"
                            Padding="8 4"
                            Cursor="Hand"
                            Margin="0 0 4 0"/>

                    <!-- 全屏 -->
                    <Button x:Name="btnFullscreen"
                            Content="全屏"
                            Click="BtnFullscreen_Click"
                            Background="Transparent"
                            Foreground="{StaticResource SF.Brush.Text.Secondary}"
                            BorderThickness="0"
                            Padding="8 4"
                            Cursor="Hand"
                            Margin="0 0 8 0"/>

                    <!-- 最小化 -->
                    <Button Content="─"
                            Click="BtnMinimize_Click"
                            Width="40" Height="32"
                            Background="Transparent"
                            Foreground="{StaticResource SF.Brush.Text.Primary}"
                            BorderThickness="0"
                            Cursor="Hand"/>

                    <!-- 最大化 -->
                    <Button Content="□"
                            Click="BtnMaximize_Click"
                            Width="40" Height="32"
                            Background="Transparent"
                            Foreground="{StaticResource SF.Brush.Text.Primary}"
                            BorderThickness="0"
                            Cursor="Hand"/>

                    <!-- 关闭 -->
                    <Button Content="✕"
                            Click="BtnClose_Click"
                            Width="40" Height="32"
                            Background="Transparent"
                            Foreground="{StaticResource SF.Brush.Text.Primary}"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 主体区域 ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航栏 -->
            <Border x:Name="SidebarBorder"
                    Grid.Column="0"
                    Background="{StaticResource SF.Brush.Bg.Surface}"
                    BorderBrush="{StaticResource SF.Brush.Border.Default}"
                    Width="{StaticResource SF.ControlsSize.SidebarExpanded}"
                    BorderThickness="0 0 1 0">

                <DockPanel>
                    <!-- 折叠按钮 -->
                    <Button x:Name="btnToggleSidebar"
                            DockPanel.Dock="Top"
                            Content="☰  菜单"
                            Height="42"
                            Background="Transparent"
                            Foreground="{StaticResource SF.Brush.Text.Primary}"
                            BorderThickness="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Padding="16 0"
                            Cursor="Hand"
                            FontSize="14"
                            Click="BtnToggleSidebar_Click"/>

                    <!-- 导航菜单 -->
                    <StackPanel x:Name="NavPanl" Margin="0 8 0 0">

                        <RadioButton Content="MES监控"
                                     Tag="{x:Type monitor:DataMonitorPage}"
                                     GroupName="Nav"
                                     IsChecked="True"
                                     Style="{StaticResource SF.Style.NavRadioButtonStyle}"
                                     Checked="Nav_Checked"/>

                        <RadioButton Content="设备管理"
                                     Tag="{x:Type device:DevicePage}"
                                     GroupName="Nav"
                                     Style="{StaticResource SF.Style.NavRadioButtonStyle}"
                                     Checked="Nav_Checked"/>

                        <RadioButton Content="通讯日志"
                                     Tag="{x:Type log:LogPage}"
                                     GroupName="Nav"
                                     Style="{StaticResource SF.Style.NavRadioButtonStyle}"
                                     Checked="Nav_Checked"/>
                        
                        <RadioButton Content="系统设置"
                                     Tag="{x:Type settings:SettingsPage}"
                                     GroupName="Nav"
                                     Style="{StaticResource SF.Style.NavRadioButtonStyle}"
                                     Checked="Nav_Checked"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 右侧内容区 -->
            <Border Grid.Column="1"
                    Background="{StaticResource SF.Brush.Bg.App}">
                <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
            </Border>
        </Grid>

    </Grid>
</Window>