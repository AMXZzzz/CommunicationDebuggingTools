<Page x:Class="CommunicationDebuggingTools.Views.Pages.Device.DevicePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:device="clr-namespace:CommunicationDebuggingTools.Views.Pages.Device"
      xmlns:models="clr-namespace:CommunicationDebuggingTools.Core.Models;assembly=CommunicationDebuggingTools.Core"
      Background="{StaticResource SF.Brush.Bg.App}"
      Title="DevicePage">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 工具栏 -->
            <RowDefinition Height="Auto"/>
            <!-- 统计 -->
            <RowDefinition Height="Auto"/>
            <!-- 设备列表（含末尾添加卡） -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== 工具栏 ==================== -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0 0 0 12">
            <Button Content="一键连接"
                    Style="{StaticResource SF.Style.PrimaryButton}"/>
            <Button Content="一键断开"
                    Style="{StaticResource SF.Style.DangerButton}"/>
            <Button Content="刷新"
                    Style="{StaticResource SF.Style.DarkButton}"/>
            <Button Content="删除"
                    Style="{StaticResource SF.Style.DangerButton}"/>
        </StackPanel>

        <!-- ==================== 统计信息 ==================== -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0 0 0 16">
            <TextBlock Text="设备总数: "
                       FontSize="14"
                       Foreground="{StaticResource SF.Brush.Text.Secondary}"
                       VerticalAlignment="Center"/>
            <!-- 数量徽章（代码里刷新，不含添加卡） -->
            <Border Background="{StaticResource SF.Brush.Bg.Hover}"
                    CornerRadius="10"
                    Padding="8 2"
                    Margin="8 0 0 0"
                    VerticalAlignment="Center">
                <TextBlock x:Name="deviceCountText"
                           Text="0"
                           FontSize="12"
                           Foreground="{StaticResource SF.Brush.Text.Primary}"/>
            </Border>
        </StackPanel>

        <!-- ==================== 设备列表 ==================== -->
        <ScrollViewer x:Name="deviceScroll"
              Grid.Row="2"
              Focusable="False"
              FocusVisualStyle="{x:Null}"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled">

            <!-- 宽度跟 ScrollViewer 视口一致，WrapPanel 才能横向换行 -->
            <ItemsControl x:Name="deviceList"
                  Focusable="False"
                  FocusVisualStyle="{x:Null}"
                  HorizontalAlignment="Left"
                  Width="{Binding ViewportWidth, ElementName=deviceScroll}">
                
                <!-- 数据模板 -->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"
                           HorizontalAlignment="Left"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <!-- 容器样式 -->
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                
                <!-- 卡片资源 -->
                <ItemsControl.Resources>
                    <!-- 设备卡片 -->
                    <DataTemplate DataType="{x:Type models:DeviceInfo}">
                        <device:DeviceCard Device="{Binding}"
                                  Margin="0 0 16 16"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"/>
                    </DataTemplate>
                    
                    <!-- 添加设备卡片 -->
                    <DataTemplate DataType="{x:Type device:AddDeviceMarker}">
                        <device:AddDeviceCard Margin="0 0 16 16"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"/>
                    </DataTemplate>
                </ItemsControl.Resources>
                
                
            </ItemsControl>
        </ScrollViewer>

        <!-- ==================== 编辑弹窗 ==================== -->
        <Popup x:Name="editPopup"
               AllowsTransparency="True"
               StaysOpen="True"
               Placement="Center">
            <Border Background="Transparent">
                <device:DeviceEditPanel x:Name="editPanel"/>
            </Border>
        </Popup>
    </Grid>
</Page>