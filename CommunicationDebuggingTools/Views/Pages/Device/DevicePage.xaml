<Page x:Class="CommunicationDebuggingTools.Views.Pages.Device.DevicePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:device="clr-namespace:CommunicationDebuggingTools.Views.Pages.Device"
      xmlns:models="clr-namespace:CommunicationDebuggingTools.Core.Models;assembly=CommunicationDebuggingTools.Core"
      Background="{StaticResource SF.Brush.Bg.App}"
      Title="DevicePage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== 工具栏 ==================== -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="16,16,16,12">
            <Button Content="一键连接"
                    Style="{StaticResource SF.Style.PrimaryButton}"
                    Click="BtnConnectAll_Click"/>
            <Button Content="一键断开"
                    Style="{StaticResource SF.Style.DangerButton}"
                    Click="BtnDisconnectAll_Click"/>
            <Button Content="刷新"
                    Style="{StaticResource SF.Style.DarkButton}"
                    Click="BtnRefresh_Click"/>
            <Button Content="删除"
                    Style="{StaticResource SF.Style.DangerButton}"
                    Click="BtnDeleteSelected_Click"/>
        </StackPanel>

        <!-- ==================== 统计 ==================== -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="16,0,16,16">
            <TextBlock Text="设备总数: "
                       FontSize="14"
                       Foreground="{StaticResource SF.Brush.Text.Secondary}"
                       VerticalAlignment="Center"/>
            <Border Background="{StaticResource SF.Brush.Bg.Hover}"
                    CornerRadius="10"
                    Padding="8,2"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center">
                <TextBlock x:Name="deviceCountText"
                           Text="0"
                           FontSize="12"
                           Foreground="{StaticResource SF.Brush.Text.Primary}"/>
            </Border>
        </StackPanel>

        <!-- ==================== 设备列表 ==================== -->
        <ScrollViewer x:Name="deviceScroll"
                      Grid.Row="2"
                      Margin="16,0,16,16"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="deviceList"
                          Focusable="False"
                          FocusVisualStyle="{x:Null}"
                          HorizontalAlignment="Left"
                          Width="{Binding ViewportWidth, ElementName=deviceScroll}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"
                                   HorizontalAlignment="Left"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.Resources>
                    <DataTemplate DataType="{x:Type models:DeviceInfo}">
                        <device:DeviceCard Device="{Binding}"
                                          Margin="0,0,16,16"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Top"/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type device:AddDeviceMarker}">
                        <device:AddDeviceCard Margin="0,0,16,16"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Top"/>
                    </DataTemplate>
                </ItemsControl.Resources>
            </ItemsControl>
        </ScrollViewer>

        <!-- ==================== 模态遮罩（与报警一致：挡住页面其它区域） ==================== -->
        <Border x:Name="editMask"
                Grid.Row="0"
                Grid.RowSpan="3"
                Background="#99000000"
                Visibility="Collapsed"
                IsHitTestVisible="True"/>

        <!-- ==================== 编辑 Popup（结构对齐 alarmPopup） ==================== -->
        <Popup x:Name="editPopup"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="Fade"
               Placement="Center">
            <Border Background="Transparent">
                <device:DeviceEditPanel x:Name="editPanel"/>
            </Border>
        </Popup>
    </Grid>
</Page>