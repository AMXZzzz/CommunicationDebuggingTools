<!-- 自定义控件：PLC 设备卡片（对齐 plc_card_style.html） -->
<UserControl x:Class="CommunicationDebuggingTools.Views.Pages.Device.DeviceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="{StaticResource SF.ControlsSize.PLCBarWidth}"
             Height="{StaticResource SF.ControlsSize.PLCBarHeight}"
             Margin="0 0 16 16">

    <!-- ==================== 卡片外框 ==================== -->
    <!-- 对应 .plc-card：Surface 底，圆角，overflow 裁切标题底边 -->
    <Border BorderThickness="1"
            CornerRadius="10"
            ClipToBounds="True">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SF.Brush.Bg.Surface}"/>
                <Setter Property="BorderBrush" Value="{StaticResource SF.Brush.Border.Default}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource SF.Brush.Border.Default}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <DockPanel LastChildFill="True">

            <!-- ==================== 标题栏 .plc-hd ==================== -->
            <!-- 背景略亮 + 底部分割线，与编辑弹窗头部一致 -->
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource SF.Brush.Bg.Hover}"
                    BorderBrush="{StaticResource SF.Brush.Border.Default}"
                    BorderThickness="0 0 0 1"
                    CornerRadius="10 10 0 0"
                    Padding="16 14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：色条 + 名称/型号 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="AccentBar"
                                Width="3"
                                Height="28"
                                CornerRadius="2"
                                Margin="0 0 10 0"
                                VerticalAlignment="Center"
                                Background="{StaticResource SF.Brush.Accent.Default}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="devicenName"
                                       Text="PLC1"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SF.Brush.Text.Primary}"/>
                            <TextBlock x:Name="plcModelName"
                                       Text="Siemens S7-1500"
                                       FontSize="11"
                                       Foreground="{StaticResource SF.Brush.Text.Secondary}"
                                       Margin="0 2 0 0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 右侧：状态灯 -->
                    <Ellipse x:Name="plcStatusLight"
                             Grid.Column="1"
                             Width="10"
                             Height="10"
                             Fill="{StaticResource SF.Brush.Status.Success}"
                             VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ==================== 内容区 .plc-body ==================== -->
            <Grid>
                <Grid.RowDefinitions >
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                    <!-- 信息行 -->
                <StackPanel Grid.Row="0"  Margin="16 14 16 0">
                    <Grid Margin="0 0 0 10">
                        <TextBlock Text="IP 地址"
                                       FontSize="13"
                                       Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                        <TextBlock x:Name="ipAddress"
                                       Text="192.168.0.1"
                                       FontSize="13"
                                       FontFamily="Consolas"
                                       Foreground="{StaticResource SF.Brush.Text.Primary}"
                                       HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0 0 0 10">
                        <TextBlock Text="协议"
                                       FontSize="13"
                                       Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                        <TextBlock x:Name="protocolName"
                                       Text="Modbus TCP"
                                       FontSize="13"
                                       Foreground="{StaticResource SF.Brush.Text.Primary}"
                                       HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="当前状态"
                                       FontSize="13"
                                       Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                        <TextBlock x:Name="plcCurrentState"
                                       Text="RUN"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource SF.Brush.Status.Success}"
                                       HorizontalAlignment="Right"/>
                    </Grid>

                </StackPanel>
                
                <!-- 底部按钮：等宽 flex -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnPrimary"
                             Content="断开"
                             Style="{StaticResource SF.Style.DisconnectButton}"/>

                    <Button x:Name="btnEdit"
                             Content="编辑"
                             Style="{StaticResource SF.Style.DarkButton}"/>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
    
    
</UserControl>