<UserControl x:Class="CommunicationDebuggingTools.Views.Pages.Device.DeviceEditPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="400">

    <Border Background="{StaticResource SF.Brush.Bg.Surface}"
            BorderBrush="{StaticResource SF.Brush.Border.Default}"
            BorderThickness="1"
            CornerRadius="10"
            ClipToBounds="True"
            SnapsToDevicePixels="True">
        <StackPanel>

            <!-- 标题 -->
            <Border Background="{StaticResource SF.Brush.Bg.Hover}"
                    CornerRadius="10 10 0 0"
                    Padding="14 12"
                    BorderThickness="0 0 0 1"
                    BorderBrush="{StaticResource SF.Brush.Border.Default}">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="3" Height="16"
                                Background="{StaticResource SF.Brush.Accent.Default}"
                                CornerRadius="1"
                                Margin="0 0 8 0"/>
                        <TextBlock Text="编辑设备"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SF.Brush.Text.Primary}"/>
                    </StackPanel>
                    <TextBlock Text="×"
                               FontSize="16"
                               Foreground="{StaticResource SF.Brush.Text.Secondary}"
                               HorizontalAlignment="Right"
                               Cursor="Hand"
                               Padding="6"
                               MouseLeftButtonUp="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- 表单 -->
            <StackPanel Margin="16 14">

                <!-- 设备名称 -->
                <TextBlock Margin="0 0 0 4">
                    <Run Text="设备名称" Foreground="{StaticResource SF.Brush.Text.Secondary}" FontSize="12"/>
                    <Run Text=" *" Foreground="{StaticResource SF.Brush.Status.Error}" FontSize="12"/>
                </TextBlock>
                <TextBox x:Name="txtName"
                         Text="PLC1"
                         Height="32"
                         Padding="8 0"
                         VerticalContentAlignment="Center"
                         Background="{StaticResource SF.Brush.Bg.App}"
                         Foreground="{StaticResource SF.Brush.Text.Primary}"
                         BorderBrush="{StaticResource SF.Brush.Border.Default}"
                         BorderThickness="1"
                         CaretBrush="{StaticResource SF.Brush.Text.Primary}"/>

                <!-- 品牌/型号 -->
                <TextBlock Text="品牌 / 型号"
                           FontSize="12"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"
                           Margin="0 12 0 4"/>
                <TextBox x:Name="txtModel"
                         Text="Siemens S7-1500"
                         Height="32"
                         Padding="8 0"
                         VerticalContentAlignment="Center"
                         Background="{StaticResource SF.Brush.Bg.App}"
                         Foreground="{StaticResource SF.Brush.Text.Primary}"
                         BorderBrush="{StaticResource SF.Brush.Border.Default}"
                         BorderThickness="1"
                         CaretBrush="{StaticResource SF.Brush.Text.Primary}"/>

                <!-- 协议 -->
                <TextBlock Margin="0 12 0 4">
                    <Run Text="协议" Foreground="{StaticResource SF.Brush.Text.Secondary}" FontSize="12"/>
                    <Run Text=" *" Foreground="{StaticResource SF.Brush.Status.Error}" FontSize="12"/>
                </TextBlock>
                
                <!-- 动态协议 -->
                <ComboBox x:Name="cmbProtocol"
                          Style="{StaticResource SF.Style.DarkComboBox}"
                          SelectedIndex="0"/>

                <!-- IP -->
                <TextBlock Margin="0 12 0 4">
                    <Run Text="IP 地址" Foreground="{StaticResource SF.Brush.Text.Secondary}" FontSize="12"/>
                    <Run Text=" *" Foreground="{StaticResource SF.Brush.Status.Error}" FontSize="12"/>
                </TextBlock>
                <TextBox x:Name="txtIp"
                         Text="192.168.0.1"
                         Height="32"
                         Padding="8 0"
                         VerticalContentAlignment="Center"
                         FontFamily="Consolas"
                         Background="{StaticResource SF.Brush.Bg.App}"
                         Foreground="{StaticResource SF.Brush.Text.Primary}"
                         BorderBrush="{StaticResource SF.Brush.Border.Default}"
                         BorderThickness="1"
                         CaretBrush="{StaticResource SF.Brush.Text.Primary}"/>

                <!-- 端口 + Unit ID -->
                <Grid Margin="0 12 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Margin="0 0 0 4">
                                <Run Text="端口" Foreground="{StaticResource SF.Brush.Text.Secondary}" FontSize="12"/>
                               <Run Text=" *" Foreground="{StaticResource SF.Brush.Status.Error}" FontSize="12"/>
                        </TextBlock>

                        <TextBox x:Name="txtPort"
                                 Text="502"
                                 Height="32"
                                 Padding="8 0"
                                 VerticalContentAlignment="Center"
                                 FontFamily="Consolas"
                                 Background="{StaticResource SF.Brush.Bg.App}"
                                 Foreground="{StaticResource SF.Brush.Text.Primary}"
                                 BorderBrush="{StaticResource SF.Brush.Border.Default}"
                                 BorderThickness="1"
                                 CaretBrush="{StaticResource SF.Brush.Text.Primary}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="站号 / Unit ID"
                                   FontSize="12"
                                   Foreground="{StaticResource SF.Brush.Text.Secondary}"
                                   Margin="0 0 0 4"/>
                        <TextBox x:Name="txtUnitId"
                                 Text="1"
                                 Height="32"
                                 Padding="8 0"
                                 VerticalContentAlignment="Center"
                                 FontFamily="Consolas"
                                 Background="{StaticResource SF.Brush.Bg.App}"
                                 Foreground="{StaticResource SF.Brush.Text.Primary}"
                                 BorderBrush="{StaticResource SF.Brush.Border.Default}"
                                 BorderThickness="1"
                                 CaretBrush="{StaticResource SF.Brush.Text.Primary}"/>
                    </StackPanel>
                </Grid>

                <!-- 轨道类型 -->
                <TextBlock Text="轨道类型"
                           FontSize="12"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"
                           Margin="0 12 0 6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnLaneSingle"
                            Grid.Column="0"
                            Content="单轨"
                            Height="32"
                            Click="BtnLaneSingle_Click"
                            Style="{StaticResource SF.Style.DarkButton}"
                            Margin="0"/>
                    <Button x:Name="btnLaneDual"
                            Grid.Column="2"
                            Content="双轨"
                            Height="32"
                            Click="BtnLaneDual_Click"
                            Style="{StaticResource SF.Style.PrimaryButton}"
                            Margin="0"/>
                </Grid>

                <!-- 当前状态（只读） -->
                <TextBlock Text="当前状态"
                           FontSize="12"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"
                           Margin="0 14 0 6"/>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8"
                                 Fill="{StaticResource SF.Brush.Status.Success}"
                                 Margin="0 0 6 0"/>
                        <TextBlock x:Name="txtStatus"
                                   Text="RUN"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SF.Brush.Status.Success}"/>
                    </StackPanel>
                    <TextBlock Text="只读 · 连接后更新"
                               FontSize="11"
                               Foreground="{StaticResource SF.Brush.Text.Secondary}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <!-- 底部按钮 -->
            <Border Background="{StaticResource SF.Brush.Bg.App}"
                    CornerRadius="0 0 10 10"
                    Padding="16 12">
                <Grid>
                    <Button Content="删除设备"
                            Style="{StaticResource SF.Style.DangerButton}"
                            Height="32"
                            HorizontalAlignment="Left"
                            Click="BtnDelete_Click"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消"
                                Style="{StaticResource SF.Style.DarkButton}"
                                Height="32"
                                Margin="0 0 8 0"
                                Click="BtnClose_Click"/>
                        <Button Content="保存"
                                Style="{StaticResource SF.Style.PrimaryButton}"
                                Height="32"
                                Click="BtnSave_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>