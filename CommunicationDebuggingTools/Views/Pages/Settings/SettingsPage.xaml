<Page x:Class="CommunicationDebuggingTools.Views.Pages.Settings.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource SF.Brush.Bg.App}"
      Title="系统设置">

    <Grid Margin="24">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="系统设置"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource SF.Brush.Text.Primary}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="后续在此配置主题、日志级别、协议默认参数等。"
                       FontSize="13"
                       Margin="0,12,0,0"
                       Foreground="{StaticResource SF.Brush.Text.Secondary}"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>