<UserControl x:Class="CommunicationDebuggingTools.Views.VariableConfigPage.Controls.VariableTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- ========== 模板色（变量表专用，可迁入主题字典） ========== -->
        <SolidColorBrush x:Key="SF.Brush.Var.Addr" Color="#93C5FD"/>
        <SolidColorBrush x:Key="SF.Brush.Var.TypeBg" Color="#1E3A5F"/>
        <SolidColorBrush x:Key="SF.Brush.Var.TypeFg" Color="#93C5FD"/>
        <SolidColorBrush x:Key="SF.Brush.Var.TypeBoolBg" Color="#14532D"/>
        <SolidColorBrush x:Key="SF.Brush.Var.TypeBoolFg" Color="#86EFAC"/>
        <SolidColorBrush x:Key="SF.Brush.Var.TypeFloatBg" Color="#422006"/>
        <SolidColorBrush x:Key="SF.Brush.Var.TypeFloatFg" Color="#FBBF24"/>
        <SolidColorBrush x:Key="SF.Brush.Var.TypeStringBg" Color="#3B1A5A"/>
        <SolidColorBrush x:Key="SF.Brush.Var.TypeStringFg" Color="#C4B5FD"/>
        <SolidColorBrush x:Key="SF.Brush.Var.RwRBg" Color="#1E3A5F"/>
        <SolidColorBrush x:Key="SF.Brush.Var.RwRFg" Color="#93C5FD"/>
        <SolidColorBrush x:Key="SF.Brush.Var.RwWBg" Color="#422006"/>
        <SolidColorBrush x:Key="SF.Brush.Var.RwWFg" Color="#FBBF24"/>
        <SolidColorBrush x:Key="SF.Brush.Var.RwRwBg" Color="#14532D"/>
        <SolidColorBrush x:Key="SF.Brush.Var.RwRwFg" Color="#86EFAC"/>
        <SolidColorBrush x:Key="SF.Brush.Var.CatStatusBg" Color="#1E3A5F"/>
        <SolidColorBrush x:Key="SF.Brush.Var.CatStatusFg" Color="#93C5FD"/>
        <SolidColorBrush x:Key="SF.Brush.Var.CatDataBg" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="SF.Brush.Var.CatDataFg" Color="#AAAAAA"/>
        <SolidColorBrush x:Key="SF.Brush.Var.CatWidthBg" Color="#3B2A1A"/>
        <SolidColorBrush x:Key="SF.Brush.Var.CatWidthFg" Color="#FBBF24"/>
        <SolidColorBrush x:Key="SF.Brush.Var.WriteBtnBg" Color="#0C4A6E"/>
        <SolidColorBrush x:Key="SF.Brush.Var.WriteBtnBorder" Color="#1E3A5F"/>
        <SolidColorBrush x:Key="SF.Brush.Var.WriteBtnFg" Color="#7DD3FC"/>
        <SolidColorBrush x:Key="SF.Brush.Var.BoolOn" Color="#4ADE80"/>
        <SolidColorBrush x:Key="SF.Brush.Var.RowHover" Color="#222222"/>

        <!-- 行悬停：用途说明气泡 -->
        <Style x:Key="SF.Style.VarRowToolTip" TargetType="ToolTip">
            <Setter Property="Background" Value="{StaticResource SF.Brush.Bg.Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SF.Brush.Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 筛选 Tab -->
        <Style x:Key="SF.Style.VarFilterTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource SF.Brush.Text.Secondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <StackPanel>
                                <ContentPresenter HorizontalAlignment="Center"/>
                                <Border x:Name="ind" Height="2" Margin="0,8,0,0" Background="Transparent"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource SF.Brush.Accent.Default}"/>
                                <Setter TargetName="ind" Property="Background"
                                        Value="{StaticResource SF.Brush.Accent.Default}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource SF.Brush.Text.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 行内编辑 / 删除图标按钮 -->
        <Style x:Key="SF.Style.VarRowIcon" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource SF.Brush.Text.Secondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Width="26" Height="26" CornerRadius="4"
                                Background="{StaticResource SF.Brush.Bg.Hover}"
                                BorderBrush="{StaticResource SF.Brush.Border.Default}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush"
                                        Value="{StaticResource SF.Brush.Accent.Default}"/>
                                <Setter Property="Foreground" Value="{StaticResource SF.Brush.Accent.Default}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 「写入」小按钮 -->
        <Style x:Key="SF.Style.VarWriteBtn" TargetType="Button">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource SF.Brush.Var.WriteBtnFg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{StaticResource SF.Brush.Var.WriteBtnBg}"
                                BorderBrush="{StaticResource SF.Brush.Var.WriteBtnBorder}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- 筛选 Tab -->
        <Border DockPanel.Dock="Top"
                BorderBrush="{StaticResource SF.Brush.Border.Default}"
                BorderThickness="0,0,0,1"
                Background="{StaticResource SF.Brush.Bg.App}">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="tabAll" Content="全部 (0)" IsChecked="True"
                             Style="{StaticResource SF.Style.VarFilterTab}"
                             Checked="Filter_Checked" Tag="All"/>
                <RadioButton x:Name="tabRead" Content="只读"
                             Style="{StaticResource SF.Style.VarFilterTab}"
                             Checked="Filter_Checked" Tag="Read"/>
                <RadioButton x:Name="tabWrite" Content="可写"
                             Style="{StaticResource SF.Style.VarFilterTab}"
                             Checked="Filter_Checked" Tag="Write"/>
                <RadioButton x:Name="tabStatus" Content="状态点"
                             Style="{StaticResource SF.Style.VarFilterTab}"
                             Checked="Filter_Checked" Tag="状态点"/>
                <RadioButton x:Name="tabData" Content="监控数据"
                             Style="{StaticResource SF.Style.VarFilterTab}"
                             Checked="Filter_Checked" Tag="监控数据"/>
            </StackPanel>
        </Border>

        <!-- 底栏统计 -->
        <Border DockPanel.Dock="Bottom" CornerRadius="8"
                Background="{StaticResource SF.Brush.Bg.Surface}"
                BorderBrush="{StaticResource SF.Brush.Border.Default}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="txtFtAll" Text="共 0 个变量" FontSize="11"
                               Foreground="{StaticResource SF.Brush.Text.Secondary}" Margin="0,0,16,0"/>
                    <TextBlock x:Name="txtFtRead" Text="只读 0" FontSize="11"
                               Foreground="{StaticResource SF.Brush.Text.Secondary}" Margin="0,0,16,0"/>
                    <TextBlock x:Name="txtFtWrite" Text="可写 0" FontSize="11"
                               Foreground="{StaticResource SF.Brush.Text.Secondary}" Margin="0,0,16,0"/>
                    <TextBlock x:Name="txtFtLive" Text="" FontSize="11"
                               Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                </StackPanel>
                <Button x:Name="btnHint" Content="^" Width="28" Height="22"
                        HorizontalAlignment="Right" Cursor="Hand"
                        Background="{StaticResource SF.Brush.Bg.Hover}"
                        Foreground="{StaticResource SF.Brush.Text.Secondary}"
                        BorderBrush="{StaticResource SF.Brush.Border.Default}"
                        BorderThickness="1" Click="BtnHint_Click" ToolTip="读写说明"/>
            </Grid>
        </Border>

        <!-- 读写说明（可折叠） -->
        <Border x:Name="hintBar" DockPanel.Dock="Bottom" CornerRadius="8" Visibility="Collapsed"
                Background="#1A2332" BorderBrush="#1E3A5F" BorderThickness="0,1,0,0"
                Padding="16,10">
            <TextBlock FontSize="12" LineHeight="22" Foreground="#64748B" TextWrapping="Wrap">
                <Run Text="· "/><Run Text="R" Foreground="#93C5FD" FontWeight="SemiBold"/>
                <Run Text=" 只读 — 仅实时显示，供 MES 监控使用"/><LineBreak/>
                <Run Text="· "/><Run Text="W" Foreground="#93C5FD" FontWeight="SemiBold"/>
                <Run Text=" 只写 — 可下发到 PLC"/><LineBreak/>
                <Run Text="· "/><Run Text="R/W" Foreground="#93C5FD" FontWeight="SemiBold"/>
                <Run Text=" 读写 — 既显示当前值，也可修改后写入"/><LineBreak/>
                <Run Text="· 可写变量在「实时值」列可直接改数，点「写入」下发到 PLC"/>
            </TextBlock>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,0,0">
            <StackPanel>
                <!-- 表头（列宽与数据行一致） -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="76"/>
                        <ColumnDefinition Width="64"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="#" FontSize="12" Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                    <TextBlock Grid.Column="1" Text="显示名称" FontSize="12" Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                    <TextBlock Grid.Column="2" Text="地址" FontSize="12" Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                    <TextBlock Grid.Column="3" Text="类型" FontSize="12" Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                    <TextBlock Grid.Column="4" Text="读写" FontSize="12" Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                    <TextBlock Grid.Column="5" Text="实时值" FontSize="12" Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                    <TextBlock Grid.Column="6" Text="单位" FontSize="12" Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                    <TextBlock Grid.Column="7" Text="分类" FontSize="12" Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                    <TextBlock Grid.Column="8" Text="操作" FontSize="12" Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                </Grid>

                <ItemsControl x:Name="listRows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- 行容器：悬停约 0.6s 显示用途说明 -->
                            <Border BorderBrush="{StaticResource SF.Brush.Border.Default}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,6"
                                    ToolTipService.InitialShowDelay="600"
                                    ToolTipService.ShowDuration="20000"
                                    ToolTipService.BetweenShowDelay="200">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background"
                                                        Value="{StaticResource SF.Brush.Var.RowHover}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.ToolTip>
                                    <ToolTip Style="{StaticResource SF.Style.VarRowToolTip}"
                                             Visibility="{Binding DescToolTipVisibility}">
                                        <StackPanel MaxWidth="280">
                                            <TextBlock Text="用途说明" FontSize="11" Margin="0,0,0,4"
                                                       Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource SF.Brush.Text.Primary}"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Border.ToolTip>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="76"/>
                                        <ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Index}" VerticalAlignment="Center"
                                               Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                               FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource SF.Brush.Text.Primary}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Address}" VerticalAlignment="Center"
                                               FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource SF.Brush.Var.Addr}"/>

                                    <Border Grid.Column="3" CornerRadius="3" Padding="6,2"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Background="{Binding TypeBg}">
                                        <TextBlock Text="{Binding DataType}" FontSize="11"
                                                   Foreground="{Binding TypeFg}"/>
                                    </Border>

                                    <Border Grid.Column="4" CornerRadius="3" Padding="6,2"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Background="{Binding AccessBg}">
                                        <TextBlock Text="{Binding AccessText}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{Binding AccessFg}"/>
                                    </Border>

                                    <StackPanel Grid.Column="5" Orientation="Horizontal" 
                                                VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding ValueText}"
                                                   FontFamily="Consolas" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding ValueTextVisibility}"
                                                   Foreground="{Binding ValueFg}"/>
                                        <TextBox Text="{Binding WriteText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="90" Height="26" FontSize="12" FontFamily="Consolas"
                                                 VerticalContentAlignment="Center" Padding="8,0"
                                                 Visibility="{Binding WriteEditorVisibility}"
                                                 Background="{StaticResource SF.Brush.Bg.App}"
                                                 Foreground="{StaticResource SF.Brush.Text.Primary}"
                                                 BorderBrush="{StaticResource SF.Brush.Border.Default}"
                                                 BorderThickness="1"/>
                                        <Button Content="写入" Style="{StaticResource SF.Style.VarWriteBtn}"
                                                Visibility="{Binding WriteEditorVisibility}"
                                                Tag="{Binding Id}" Click="BtnWrite_Click"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="6" Text="{Binding UnitText}" VerticalAlignment="Center"
                                               Foreground="{StaticResource SF.Brush.Text.Secondary}"/>

                                    <Border Grid.Column="7" CornerRadius="3" Padding="6,2"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Background="{Binding CategoryBg}">
                                        <TextBlock Text="{Binding Category}" FontSize="11"
                                                   Foreground="{Binding CategoryFg}"/>
                                    </Border>

                                    <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="✎" Style="{StaticResource SF.Style.VarRowIcon}"
                                                Tag="{Binding Id}" Click="BtnEdit_Click" ToolTip="编辑"/>
                                        <Button Content="×" Style="{StaticResource SF.Style.VarRowIcon}"
                                                Tag="{Binding Id}" Click="BtnDelete_Click" ToolTip="删除"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="txtEmpty" Text="该设备暂无变量" Visibility="Collapsed"
                           Margin="0,24,0,0" HorizontalAlignment="Center"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>