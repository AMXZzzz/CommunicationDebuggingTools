<UserControl x:Class="CommunicationDebuggingTools.Views.VariableConfigPage.Controls.VariableTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
        <StackPanel>
            <!-- 表头 -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="#" FontSize="11"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                <TextBlock Grid.Column="1" Text="显示名称" FontSize="11"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                <TextBlock Grid.Column="2" Text="地址" FontSize="11"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                <TextBlock Grid.Column="3" Text="类型" FontSize="11"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                <TextBlock Grid.Column="4" Text="读写" FontSize="11"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                <TextBlock Grid.Column="5" Text="实时值" FontSize="11"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                <TextBlock Grid.Column="6" Text="操作" FontSize="11"
                           Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
            </Grid>

            <!-- 行 -->
            <ItemsControl x:Name="listRows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="0,8"
                                BorderBrush="{StaticResource SF.Brush.Border.Default}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Index}"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource SF.Brush.Text.Primary}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Address}"
                                           FontFamily="Consolas"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource SF.Brush.Text.Secondary}"/>

                                <Border Grid.Column="3" CornerRadius="4" Padding="8,2"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{StaticResource SF.Brush.Bg.Hover}">
                                    <TextBlock Text="{Binding DataType}" FontSize="11"
                                               Foreground="{StaticResource SF.Brush.Text.Primary}"/>
                                </Border>

                                <Border Grid.Column="4" CornerRadius="4" Padding="6,2"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{StaticResource SF.Brush.Bg.Hover}">
                                    <TextBlock Text="{Binding AccessText}" FontSize="11"
                                               Foreground="{StaticResource SF.Brush.Status.Success}"/>
                                </Border>

                                <TextBlock Grid.Column="5" Text="{Binding ValueText}"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource SF.Brush.Text.Primary}"/>

                                <StackPanel Grid.Column="6" Orientation="Horizontal">
                                    <Button Content="编辑"
                                            Style="{StaticResource SF.Style.DarkButton}"
                                            Margin="0,0,6,0"
                                            Tag="{Binding Id}"
                                            Click="BtnEdit_Click"/>
                                    <Button Content="删除"
                                            Style="{StaticResource SF.Style.DangerButton}"
                                            Tag="{Binding Id}"
                                            Click="BtnDelete_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="txtEmpty"
                       Text="该设备暂无变量"
                       Visibility="Collapsed"
                       Margin="0,24,0,0"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource SF.Brush.Text.Secondary}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>