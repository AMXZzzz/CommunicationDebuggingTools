<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 深色主题勾选框 -->
    <Style x:Key="SF.Style.DarkCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource SF.Brush.Text.Primary}"/>
        <Setter Property="Background" Value="{StaticResource SF.Brush.Bg.Hover}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SF.Brush.Border.Default}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="box"
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3"
                        SnapsToDevicePixels="True">
                        <!-- 勾选标记 -->
                        <Path x:Name="mark"
                          Data="M 3,9 L 7,13 L 15,4"
                          Stroke="{StaticResource SF.Brush.Accent.Default}"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Visibility="Collapsed"
                          Stretch="None"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Width="14"
                          Height="14"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="box" Property="BorderBrush"
                                Value="{StaticResource SF.Brush.Accent.Default}"/>
                            <Setter TargetName="box" Property="Background"
                                Value="{StaticResource SF.Brush.Bg.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush"
                                Value="{StaticResource SF.Brush.Accent.Default}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="box" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>