<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== 深色按钮（普通操作） ==================== -->
    <Style x:Key="SF.Style.DarkButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="{StaticResource SF.Brush.Bg.Hover}"/>
        <Setter Property="Foreground" Value="{StaticResource SF.Brush.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SF.Brush.Border.Default}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="{StaticResource SF.ControlsSize.ButtonHeight}"/>
        <Setter Property="MinWidth" Value="{StaticResource SF.ControlsSize.ButtonWidth}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="12 0"/>
        <Setter Property="Margin" Value="0 0 12 0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 悬停 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnRoot" Property="Background"
                                    Value="{StaticResource SF.Brush.Bg.Pressed}"/>
                        </Trigger>
                        <!-- 按下 -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="btnRoot" Property="Background"
                                    Value="{StaticResource SF.Brush.Bg.Pressed}"/>
                        </Trigger>
                        <!-- 禁用 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="btnRoot" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 主按钮（蓝色系） ==================== -->
    <Style x:Key="SF.Style.PrimaryButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="{StaticResource SF.Brush.Accent.Default}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="{StaticResource SF.ControlsSize.ButtonHeight}"/>
        <Setter Property="MinWidth" Value="{StaticResource SF.ControlsSize.ButtonWidth}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="12 0"/>
        <Setter Property="Margin" Value="0 0 12 0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 悬停：亮蓝 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{StaticResource SF.Brush.Accent.Hover}"/>
                        </Trigger>
                        <!-- 按下：深蓝 -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{StaticResource SF.Brush.Accent.Pressed}"/>
                        </Trigger>
                        <!-- 禁用 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 危险按钮（红色系） ==================== -->
    <Style x:Key="SF.Style.DangerButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="{StaticResource SF.Brush.Button.Danger.Bg}"/>
        <Setter Property="Foreground" Value="{StaticResource SF.Brush.Button.Danger.Fg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SF.Brush.Button.Danger.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="{StaticResource SF.ControlsSize.ButtonHeight}"/>
        <Setter Property="MinWidth" Value="{StaticResource SF.ControlsSize.ButtonWidth}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="12 0"/>
        <Setter Property="Margin" Value="0 0 12 0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 悬停 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{StaticResource SF.Brush.Button.Danger.Hover}"/>
                        </Trigger>
                        <!-- 按下 -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{StaticResource SF.Brush.Button.Danger.Pressed}"/>
                        </Trigger>
                        <!-- 禁用 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>