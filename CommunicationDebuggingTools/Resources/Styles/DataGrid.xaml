<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 列头 -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource SF.Brush.Bg.Hover}"/>
        <Setter Property="Foreground" Value="{StaticResource SF.Brush.Text.Secondary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SF.Brush.Border.Default}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- 单元格 -->
    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Foreground" Value="{StaticResource SF.Brush.Text.Primary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource SF.Brush.Bg.Hover}"/>
                <Setter Property="Foreground" Value="{StaticResource SF.Brush.Text.Primary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 行：去掉默认蓝选中 -->
    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource SF.Brush.Bg.Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource SF.Brush.Text.Primary}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SF.Brush.Bg.Hover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource SF.Brush.Bg.Hover}"/>
                <Setter Property="Foreground" Value="{StaticResource SF.Brush.Text.Primary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 表格整体 -->
    <Style x:Key="SF.Style.DataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource SF.Brush.Bg.Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource SF.Brush.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SF.Brush.Border.Default}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowBackground" Value="{StaticResource SF.Brush.Bg.Surface}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource SF.Brush.Bg.Hover}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource SF.Brush.Border.Default}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource SF.Brush.Border.Default}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <!-- 去掉选中时系统高亮 -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>
</ResourceDictionary>