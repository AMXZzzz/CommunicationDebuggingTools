<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== Color（原始色） ========== -->
    <Color x:Key="SF.Color.Bg.App">#FF1E1E1E</Color>
    <Color x:Key="SF.Color.Bg.Surface">#FF252526</Color>
    <Color x:Key="SF.Color.Bg.TopBar">#FF2D2D30</Color>
    <Color x:Key="SF.Color.Bg.Hover">#FF3E3E42</Color>
    <Color x:Key="SF.Color.Bg.Pressed">#FF2A2A2E</Color>

    <Color x:Key="SF.Color.Border.Default">#FF3F3F46</Color>

    <Color x:Key="SF.Color.Text.Primary">#FFD4D4D4</Color>
    <Color x:Key="SF.Color.Text.Secondary">#FF9D9D9D</Color>

    <Color x:Key="SF.Color.Accent.Default">#FF007ACC</Color>
    <Color x:Key="SF.Color.Accent.Hover">#FF3B8CFF</Color>
    <Color x:Key="SF.Color.Accent.Pressed">#FF1A6FE0</Color>

    <Color x:Key="SF.Color.Status.Success">#FF4EC9B0</Color>
    <Color x:Key="SF.Color.Status.Warning">#FFCE9178</Color>
    <Color x:Key="SF.Color.Status.Error">#FFF44747</Color>

    <Color x:Key="SF.Color.Button.Danger.Bg">#FF4A2A2A</Color>
    <Color x:Key="SF.Color.Button.Danger.Fg">#FFF44747</Color>
    <Color x:Key="SF.Color.Button.Danger.Border">#FF5A3A3A</Color>
    <Color x:Key="SF.Color.Button.Danger.Hover">#FF5A3030</Color>
    <Color x:Key="SF.Color.Button.Danger.Pressed">#FF3A2020</Color>
    <!-- 弹层遮罩 -->
    <Color x:Key="SF.Color.Overlay">#80000000</Color>


    <!-- ========== MES 监控专用 ========== -->
    <Color x:Key="SF.Color.Mes.LiveBg">#FF14532D</Color>
    <Color x:Key="SF.Color.Mes.LiveFg">#FF4ADE80</Color>

    <Color x:Key="SF.Color.Mes.AlarmBg">#FF450A0A</Color>
    <Color x:Key="SF.Color.Mes.AlarmBorder">#FF7F1D1D</Color>
    <Color x:Key="SF.Color.Mes.AlarmFg">#FFF87171</Color>

    <Color x:Key="SF.Color.Mes.WidthBarBg">#FF1A2332</Color>
    <Color x:Key="SF.Color.Mes.WidthBarBorder">#FF1E3A5F</Color>
    <Color x:Key="SF.Color.Mes.WidthTitle">#FF93C5FD</Color>
    <Color x:Key="SF.Color.Mes.WidthIconBg">#FF1E40AF</Color>
    <Color x:Key="SF.Color.Mes.WidthInputBg">#FF0F172A</Color>
    <Color x:Key="SF.Color.Mes.WidthInputBorder">#FF334155</Color>
    <Color x:Key="SF.Color.Mes.WidthMuted">#FF64748B</Color>
    <Color x:Key="SF.Color.Mes.WidthValue">#FFE2E8F0</Color>
    <Color x:Key="SF.Color.Mes.WidthAdjusting">#FFFBBF24</Color>
    <Color x:Key="SF.Color.Mes.ModeOnBg">#FF1E40AF</Color>
    <Color x:Key="SF.Color.Mes.ModeOnBorder">#FF3B82F6</Color>
    <Color x:Key="SF.Color.Mes.ModeOffFg">#FF888888</Color>
    <Color x:Key="SF.Color.Mes.TagDualBg">#FF1E3A5F</Color>
    <Color x:Key="SF.Color.Mes.TagSingleBg">#FF334155</Color>
    <Color x:Key="SF.Color.Mes.TagSingleFg">#FF94A3B8</Color>


    <!-- Brush -->
    <SolidColorBrush x:Key="SF.Brush.Mes.LiveBg" Color="{StaticResource SF.Color.Mes.LiveBg}"/>
    <SolidColorBrush x:Key="SF.Brush.Mes.LiveFg" Color="{StaticResource SF.Color.Mes.LiveFg}"/>
    <SolidColorBrush x:Key="SF.Brush.Mes.AlarmBg" Color="{StaticResource SF.Color.Mes.AlarmBg}"/>
    <SolidColorBrush x:Key="SF.Brush.Mes.AlarmBorder" Color="{StaticResource SF.Color.Mes.AlarmBorder}"/>
    <SolidColorBrush x:Key="SF.Brush.Mes.AlarmFg" Color="{StaticResource SF.Color.Mes.AlarmFg}"/>
    <SolidColorBrush x:Key="SF.Brush.Mes.WidthBarBg" Color="{StaticResource SF.Color.Mes.WidthBarBg}"/>
    <SolidColorBrush x:Key="SF.Brush.Mes.WidthBarBorder" Color="{StaticResource SF.Color.Mes.WidthBarBorder}"/>
    <SolidColorBrush x:Key="SF.Brush.Mes.WidthTitle" Color="{StaticResource SF.Color.Mes.WidthTitle}"/>
    <SolidColorBrush x:Key="SF.Brush.Mes.WidthIconBg" Color="{StaticResource SF.Color.Mes.WidthIconBg}"/>
    <SolidColorBrush x:Key="SF.Brush.Mes.WidthInputBg" Color="{StaticResource SF.Color.Mes.WidthInputBg}"/>
    <SolidColorBrush x:Key="SF.Brush.Mes.WidthInputBorder" Color="{StaticResource SF.Color.Mes.WidthInputBorder}"/>
    <SolidColorBrush x:Key="SF.Brush.Mes.WidthMuted" Color="{StaticResource SF.Color.Mes.WidthMuted}"/>
    <SolidColorBrush x:Key="SF.Brush.Mes.WidthValue" Color="{StaticResource SF.Color.Mes.WidthValue}"/>
    <SolidColorBrush x:Key="SF.Brush.Mes.WidthAdjusting" Color="{StaticResource SF.Color.Mes.WidthAdjusting}"/>
    <SolidColorBrush x:Key="SF.Brush.Mes.ModeOnBg" Color="{StaticResource SF.Color.Mes.ModeOnBg}"/>
    <SolidColorBrush x:Key="SF.Brush.Mes.ModeOnBorder" Color="{StaticResource SF.Color.Mes.ModeOnBorder}"/>
    <SolidColorBrush x:Key="SF.Brush.Mes.ModeOffFg" Color="{StaticResource SF.Color.Mes.ModeOffFg}"/>
    <SolidColorBrush x:Key="SF.Brush.Mes.TagDualBg" Color="{StaticResource SF.Color.Mes.TagDualBg}"/>
    <SolidColorBrush x:Key="SF.Brush.Mes.TagSingleBg" Color="{StaticResource SF.Color.Mes.TagSingleBg}"/>
    <SolidColorBrush x:Key="SF.Brush.Mes.TagSingleFg" Color="{StaticResource SF.Color.Mes.TagSingleFg}"/>
    <SolidColorBrush x:Key="SF.Brush.Text.OnAccent" Color="#FFFFFFFF"/>

    <!-- ========== Brush（界面只引用这些） ========== -->
    <SolidColorBrush x:Key="SF.Brush.Bg.App" Color="{StaticResource SF.Color.Bg.App}"/>
    <SolidColorBrush x:Key="SF.Brush.Bg.Surface" Color="{StaticResource SF.Color.Bg.Surface}"/>
    <SolidColorBrush x:Key="SF.Brush.Bg.TopBar" Color="{StaticResource SF.Color.Bg.TopBar}"/>
    <SolidColorBrush x:Key="SF.Brush.Bg.Hover" Color="{StaticResource SF.Color.Bg.Hover}"/>
    <SolidColorBrush x:Key="SF.Brush.Bg.Pressed" Color="{StaticResource SF.Color.Bg.Pressed}"/>

    <SolidColorBrush x:Key="SF.Brush.Border.Default" Color="{StaticResource SF.Color.Border.Default}"/>

    <SolidColorBrush x:Key="SF.Brush.Text.Primary" Color="{StaticResource SF.Color.Text.Primary}"/>
    <SolidColorBrush x:Key="SF.Brush.Text.Secondary" Color="{StaticResource SF.Color.Text.Secondary}"/>

    <SolidColorBrush x:Key="SF.Brush.Accent.Default" Color="{StaticResource SF.Color.Accent.Default}"/>
    <SolidColorBrush x:Key="SF.Brush.Accent.Hover" Color="{StaticResource SF.Color.Accent.Hover}"/>
    <SolidColorBrush x:Key="SF.Brush.Accent.Pressed" Color="{StaticResource SF.Color.Accent.Pressed}"/>

    <SolidColorBrush x:Key="SF.Brush.Status.Success" Color="{StaticResource SF.Color.Status.Success}"/>
    <SolidColorBrush x:Key="SF.Brush.Status.Warning" Color="{StaticResource SF.Color.Status.Warning}"/>
    <SolidColorBrush x:Key="SF.Brush.Status.Error" Color="{StaticResource SF.Color.Status.Error}"/>

    <SolidColorBrush x:Key="SF.Brush.Button.Danger.Bg" Color="{StaticResource SF.Color.Button.Danger.Bg}"/>
    <SolidColorBrush x:Key="SF.Brush.Button.Danger.Fg" Color="{StaticResource SF.Color.Button.Danger.Fg}"/>
    <SolidColorBrush x:Key="SF.Brush.Button.Danger.Border" Color="{StaticResource SF.Color.Button.Danger.Border}"/>
    <SolidColorBrush x:Key="SF.Brush.Button.Danger.Hover" Color="{StaticResource SF.Color.Button.Danger.Hover}"/>
    <SolidColorBrush x:Key="SF.Brush.Button.Danger.Pressed" Color="{StaticResource SF.Color.Button.Danger.Pressed}"/>
    <SolidColorBrush x:Key="SF.Brush.Overlay" Color="{StaticResource SF.Color.Overlay}"/>

</ResourceDictionary>